# Cloudflare Pages reads this from the build output.
#
# Vite fingerprints every asset filename with a content hash, so those files can
# be cached for ever — a change ships under a new name. The entry document must
# never be cached, or a phone that has played once keeps loading the old build
# and no amount of pushing changes what the player sees.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache

/ironline.html
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
